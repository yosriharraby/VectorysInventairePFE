{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=SERVER_NAME\\SQLEXPRESS;Database=VectorysDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "VectorysInventaire",
    "Audience": "VectorysInventaireClients"
  },
  "Cors": {
    "AllowedOrigins": [ "http://SERVER_IP_OR_HOSTNAME", "http://SERVER_IP_OR_HOSTNAME:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Urls": "http://0.0.0.0:5000"
}
